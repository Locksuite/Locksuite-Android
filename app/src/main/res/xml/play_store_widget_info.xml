<?xml version="1.0" encoding="utf-8"?>
<!-- Tienda Play (B.101): una sola celda, tamaño fijo, para que se vea como un ícono. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="86400000"
    android:initialLayout="@layout/widget_play_store"
    android:previewImage="@drawable/ic_play_store_tile"
    android:description="@string/widget_play_store_description"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
